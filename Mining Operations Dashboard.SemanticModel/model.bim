            "isHidden": true
          },
          {
            "name": "certified_sd_gpt",
            "dataType": "double",
            "sourceColumn": "certified_sd_gpt",
            "formatString": "0.000",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "description",
            "dataType": "string",
            "sourceColumn": "description",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
