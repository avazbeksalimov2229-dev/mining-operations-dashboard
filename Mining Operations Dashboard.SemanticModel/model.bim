            "sourceColumn": "equipment_id",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "start_datetime",
            "dataType": "dateTime",
            "sourceColumn": "start_datetime",
            "formatString": "yyyy-mm-dd hh:nn",
            "summarizeBy": "none"
          },
          {
            "name": "end_datetime",
            "dataType": "dateTime",
            "sourceColumn": "end_datetime",
            "formatString": "yyyy-mm-dd hh:nn",
            "summarizeBy": "none"
          },
          {
            "name": "duration_h",
            "dataType": "double",
            "sourceColumn": "duration_h",
            "formatString": "#,0.0",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "downtime_type",
            "dataType": "string",
            "sourceColumn": "downtime_type",
            "summarizeBy": "none"
          },
          {
            "name": "category",
            "dataType": "string",
            "sourceColumn": "category",
            "summarizeBy": "none"
          },
          {
            "name": "description",
            "dataType": "string",
            "sourceColumn": "description",
            "summarizeBy": "none"
          },
          {
            "name": "work_order",
            "dataType": "string",
            "sourceColumn": "work_order",
            "summarizeBy": "none"
          },
          {
            "name": "start_date",
            "dataType": "dateTime",
            "sourceColumn": "start_date",
            "formatString": "yyyy-mm-dd",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "fact_downtime_events",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFolder & \"fact_downtime_events.csv\"), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {",
                "        {\"event_id\", type text}, {\"equipment_id\", type text}, {\"start_datetime\", type datetime},",
                "        {\"end_datetime\", type datetime}, {\"duration_h\", type number}, {\"downtime_type\", type text},",
                "        {\"category\", type text}, {\"description\", type text}, {\"work_order\", type text}}, \"en-US\"),",
                "    StartDate = Table.AddColumn(Typed, \"start_date\", each Date.From([start_datetime]), type date)",
                "in",
                "    StartDate"
              ]
            }
          }
        ]
      },
      {
        "name": "fact_assays",
        "columns": [
          {
            "name": "sample_id",
            "dataType": "string",
            "sourceColumn": "sample_id",
            "summarizeBy": "none"
          },
          {
            "name": "batch_id",
            "dataType": "string",
            "sourceColumn": "batch_id",
            "summarizeBy": "none"
          },
          {
            "name": "sample_date",
            "dataType": "dateTime",
            "sourceColumn": "sample_date",
            "formatString": "yyyy-mm-dd",
            "summarizeBy": "none"
          },
          {
            "name": "pit_id",
            "dataType": "string",
            "sourceColumn": "pit_id",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "lab",
            "dataType": "string",
            "sourceColumn": "lab",
            "summarizeBy": "none"
          },
          {
            "name": "sample_type",
            "dataType": "string",
            "sourceColumn": "sample_type",
            "summarizeBy": "none"
          },
          {
            "name": "parent_sample_id",
            "dataType": "string",
            "sourceColumn": "parent_sample_id",
            "summarizeBy": "none"
          },
          {
            "name": "crm_id",
            "dataType": "string",
            "sourceColumn": "crm_id",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "below_detection",
            "dataType": "boolean",
            "sourceColumn": "below_detection",
            "summarizeBy": "none"
          },
          {
            "name": "au_value",
            "dataType": "double",
            "sourceColumn": "au_value",
            "formatString": "0.00",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "type": "calculated",
            "name": "CRM Z-Score",
            "dataType": "double",
            "isDataTypeInferred": true,
            "expression": [
              "IF (",
              "    fact_assays[sample_type] = \"CRM\",",
              "    DIVIDE ( fact_assays[au_value] - RELATED ( dim_crm[certified_au_gpt] ), RELATED ( dim_crm[certified_sd_gpt] ) )",
              ")"
            ],
            "summarizeBy": "none",
            "formatString": "0.00"
          },
          {
            "type": "calculated",
            "name": "Parent Au (g/t)",
            "dataType": "double",
            "isDataTypeInferred": true,
            "expression": [
              "IF (",
              "    fact_assays[sample_type] = \"Field Duplicate\",",
              "    LOOKUPVALUE ( fact_assays[au_value], fact_assays[sample_id], fact_assays[parent_sample_id] )",
              ")"
            ],
            "summarizeBy": "none",
            "formatString": "0.00"
          },
          {
            "type": "calculated",
            "name": "QC Status",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              "SWITCH (",
              "    fact_assays[sample_type],",
              "    \"CRM\",",
              "        SWITCH (",
              "            TRUE (),",
              "            ABS ( fact_assays[CRM Z-Score] ) > 3, \"Fail\",",
              "            ABS ( fact_assays[CRM Z-Score] ) > 2, \"Warning\",",
              "            \"Pass\"",
              "        ),",
              "    \"Blank\", IF ( fact_assays[au_value] > 0.05, \"Fail\", \"Pass\" ),",
              "    \"Field Duplicate\",",
              "        VAR a = fact_assays[Parent Au (g/t)]",
              "        VAR b = fact_assays[au_value]",
              "        VAR m = ( a + b ) / 2",
              "        RETURN",
              "            IF ( m < 0.1, \"Not assessed\", IF ( DIVIDE ( ABS ( a - b ), m ) > 0.2, \"Fail\", \"Pass\" ) ),",
              "    BLANK ()",
              ")"
            ],
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "fact_assays",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFolder & \"fact_assays.csv\"), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {",
                "        {\"sample_id\", type text}, {\"batch_id\", type text}, {\"sample_date\", type date}, {\"pit_id\", type text},",
                "        {\"lab\", type text}, {\"sample_type\", type text}, {\"parent_sample_id\", type text},",
                "        {\"crm_id\", type text}, {\"au_gpt\", type text}}, \"en-US\"),",
                "    EmptyToNull = Table.ReplaceValue(Typed, \"\", null, Replacer.ReplaceValue, {\"parent_sample_id\", \"crm_id\"}),",
                "    BelowDetection = Table.AddColumn(EmptyToNull, \"below_detection\", each Text.StartsWith([au_gpt], \"<\"), type logical),",
                "    AuValue = Table.AddColumn(BelowDetection, \"au_value\",",
                "        each if [below_detection] then 0.005 else Number.From([au_gpt], \"en-US\"), type number),",
                "    Removed = Table.RemoveColumns(AuValue, {\"au_gpt\"})",
                "in",
                "    Removed"
              ]
            }
          }
        ]
      },
      {
        "name": "dim_pit",
